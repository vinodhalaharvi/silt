# Filled in by packs/agent-gateway/host/release.sh, which cross-compiles the
# binary, packs the tarball and prints the line below. Buildroot refuses a
# download that does not match it, so this file is what makes a fetched
# binary as pinned as a committed one.
#
# sha256 <64 hex characters>  agent-gateway-host-0.1.0-aarch64.tar.xz
