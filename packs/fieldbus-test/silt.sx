;; One simulated device on a dev board, reachable over several protocols.
;;
;; /etc/silt-sim.json describes the device: its tags, how each one moves,
;; and where each appears on Modbus, OPC UA and CAN. silt-sim validates it
;; and publishes a tag table into /dev/shm; each protocol daemon serves
;; that table. So a setpoint written over Modbus is the same value every
;; other protocol reports, and the map lives in one file rather than three.
;;
;;   silt check --buildroot ~/buildroot
;;
;; The device is a file, not something fixed in the image: push a new one
;; with curl -X POST --data-binary @device.json http://<board>:8080/config
;;
;; For testing on the bench, not for shipping: the servers are anonymous
;; and unencrypted by design, so a client can connect with no setup at all.

(pack fieldbus-test
  (version "0.6.0")
  (doc "One simulated device on Modbus, OPC UA, CAN and MQTT, configured over HTTP")

  (requires
    (buildroot "2025.02.16"))

  (external "br2-external")

  (provides
    (feature fieldbus-test)))
