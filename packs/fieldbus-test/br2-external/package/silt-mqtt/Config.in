config BR2_PACKAGE_SILT_MQTT
	bool "silt-mqtt"
	depends on BR2_USE_MMU # start-stop-daemon -b forks
	depends on BR2_TOOLCHAIN_HAS_THREADS # paho-mqtt-c
	select BR2_PACKAGE_SILT_SIM
	select BR2_PACKAGE_PAHO_MQTT_C
	select BR2_PACKAGE_MOSQUITTO
	help
	  The device on MQTT: every tag published to the local broker as it
	  changes, on silt/<device>/<tag>, retained, with writes accepted on
	  silt/<device>/<tag>/set. Northbound, the way a gateway publishes
	  what it reads from the field protocols.

comment "silt-mqtt needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
