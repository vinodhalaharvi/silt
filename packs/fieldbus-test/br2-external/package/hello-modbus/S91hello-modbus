#!/bin/sh
#
# Start the bench Modbus TCP server on port 502.
#
# No wait for the network, unlike S90hello-opcua: libmodbus binds
# INADDR_ANY, which works before DHCP has given the board an address.
#

DAEMON=/usr/bin/hello-modbus
PIDFILE=/var/run/hello-modbus.pid

case "$1" in
start)
	printf "Starting hello-modbus: "
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" \
		&& echo "OK" || echo "FAIL"
	;;
stop)
	printf "Stopping hello-modbus: "
	start-stop-daemon -K -q -p "$PIDFILE" && rm -f "$PIDFILE" \
		&& echo "OK" || echo "FAIL"
	;;
restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
