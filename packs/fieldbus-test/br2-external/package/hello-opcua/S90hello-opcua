#!/bin/sh
#
# Start the bench OPC UA server on port 4840.
#
# open62541 chooses its listening addresses with getaddrinfo(AI_ADDRCONFIG),
# which returns IPv4 only once the machine has a non-loopback IPv4 address.
# Started before DHCP finishes, the server runs but is not listening on
# IPv4, and every client gets "connection refused". So wait for an address,
# in the background, so a board with no network does not hold up the boot.
#

DAEMON=/usr/bin/hello-opcua
PIDFILE=/var/run/hello-opcua.pid
WAIT=60

have_ipv4() {
	ip -4 addr show 2>/dev/null | grep "inet " | grep -qv "127\.0\.0\.1"
}

case "$1" in
start)
	printf "Starting hello-opcua: "
	(
		i=0
		while [ "$i" -lt "$WAIT" ] && ! have_ipv4; do
			sleep 1
			i=$((i + 1))
		done
		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON"
	) &
	echo "OK (starts once there is an IPv4 address)"
	;;
stop)
	printf "Stopping hello-opcua: "
	start-stop-daemon -K -q -p "$PIDFILE" && rm -f "$PIDFILE" \
		&& echo "OK" || echo "FAIL"
	;;
restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
