#!/bin/sh
#
# Start CAN on the bus named in /etc/default/silt-can, vcan0 by default.
#
# For a real CAN HAT, set IFACE and BITRATE in that file; see its comments
# for the device-tree overlay the board needs. The daemon waits for the
# interface itself, so it also works when a driver appears late in the boot.
#

DAEMON=/usr/bin/silt-cand
PIDFILE=/var/run/silt-can.pid
LOG=/var/log/silt-can.log

IFACE=vcan0
BITRATE=
[ -r /etc/default/silt-can ] && . /etc/default/silt-can

# A real CAN interface needs its bitrate set before it will come up; vcan
# takes none. The interface may appear late if its driver is a module, so
# a failure here is not fatal: the daemon waits for the interface anyway.
bring_up() {
	[ -n "$BITRATE" ] || return 0
	ip link show "$IFACE" >/dev/null 2>&1 || return 0
	ip link set "$IFACE" down 2>/dev/null
	ip link set "$IFACE" type can bitrate "$BITRATE" && ip link set "$IFACE" up
}

case "$1" in
start)
	printf "Starting silt-can on %s: " "$IFACE"
	bring_up
	start-stop-daemon -S -q -b -m -p "$PIDFILE" \
		-x /bin/sh -- -c "exec $DAEMON -i $IFACE >> $LOG 2>&1" \
		&& echo "OK" || echo "FAIL"
	;;
stop)
	printf "Stopping silt-can: "
	start-stop-daemon -K -q -p "$PIDFILE" && rm -f "$PIDFILE" \
		&& echo "OK" || echo "FAIL"
	;;
restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
