;; Tailscale for Buildroot.
;;
;; Buildroot ships the tailscale package itself. This pack carries what it
;; does not: a sysv init script, since upstream installs a systemd unit only
;; and these images are BusyBox init, and a defaults file for the auth key
;; and the routes to advertise.
;;
;; The daemon earns a secret at runtime, which an image regenerated from a
;; config file has nowhere natural to keep. See feature:tailscale.

(pack tailscale
  (version "0.1.0")
  (doc "tailscaled on a Buildroot image, with state and subnet routing")

  (requires
    (buildroot "2025.02.16"))

  (external "br2-external")

  (provides
    (feature tailscale)))
