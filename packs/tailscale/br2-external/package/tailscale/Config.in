config BR2_PACKAGE_TAILSCALE
	bool "tailscale"
	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	select BR2_PACKAGE_HOST_GO
	select BR2_PACKAGE_CA_CERTIFICATES  # TLS to the coordination server
	help
	  Tailscale: a WireGuard-based mesh VPN that needs no port
	  forwarding and no dynamic DNS, because nodes find each other
	  through a coordination server.

	  Two binaries: tailscaled, the daemon, and tailscale, the
	  command you drive it with. Together they are tens of megabytes,
	  against a few hundred kilobytes for wireguard-tools, because
	  this is a Go program carrying its own WireGuard implementation,
	  its own DNS handling and its own network stack.

	  https://tailscale.com

comment "tailscale needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
