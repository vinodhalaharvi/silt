# Assertions run over the serial console after login, one per line:
#   COMMAND <tab> text that must appear in its output
#
# They are about what the fragments claimed, not about Linux in general. Each
# line here should be traceable to something an image states.

uname -m	aarch64
cat /etc/os-release	Buildroot
hello-silt	hello from silt
ls /usr/bin/hello-silt	/usr/bin/hello-silt
mount	on / type ext4
ip link show eth0	eth0
