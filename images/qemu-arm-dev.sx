;; Kernel + rootfs for QEMU aarch64. The reference image: this is the one that has
;; to boot before anything else in the project is worth measuring.
;;
;; Baseline for comparison is buildroot/configs/qemu_aarch64_virt_defconfig, which
;; is 18 lines and expands to 451 symbols set. Those numbers are the honest scale
;; of the saving and should be re-measured, not assumed.

(image qemu-arm-dev

  (compose
    target:qemu-aarch64-virt
    profile:minimal
    feature:networking)

  ;; No (custom-version ...) here, on purpose.
  ;;
  ;; An earlier draft pinned "6.18.7" — a number invented while writing an
  ;; example, never checked against a Buildroot release. Pinning a version also
  ;; obliges you to declare its header series, and Buildroot 2025.02.16 stops at
  ;; BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12: no 6_18 symbol exists. So
  ;; olddefconfig dropped the line without a word, the Kernel Headers choice
  ;; fell back to REALLY_OLD, and the build installed 2.6 headers against a 6.18
  ;; kernel before check-kernel-headers.sh caught it.
  ;;
  ;; The silent drop of DESIGN.md §14.5, landing on Silt's own output. Two
  ;; symbols that must move together, one of which does not exist in the target
  ;; release, and nothing anywhere said so.
  ;;
  ;; BR2_LINUX_KERNEL_LATEST_VERSION avoids the coupling entirely: it is 6.12.91
  ;; on this release and selects the matching headers itself. A pinned version
  ;; is still legitimate, but it needs a rule tying the version literal to its
  ;; series, which needs literal comparison — the declared-opaque tier of §8.3.

  ;; Not expressible as constraints (DESIGN.md §14.3, §14.4). Carried verbatim,
  ;; counted in every report, excluded from the fixpoint diff by declaration.
  ;; BR2_GLOBAL_PATCH_DIR is deliberately absent. Upstream
  ;; qemu_aarch64_virt_defconfig sets it to "board/qemu/patches", and copying
  ;; that verbatim broke the build on Buildroot 2025.02.16: the directory holds
  ;; a MIPS vdso patch that apply-patches.sh applies twice for linux-headers,
  ;; failing before anything is compiled. Upstream sets it because the same
  ;; board directory serves every qemu target, the MIPS ones included.
  ;;
  ;; This is what opaque costs. Silt carried the value correctly and could not
  ;; know it was harmful, because a patch directory is exactly the kind of thing
  ;; the constraint model does not model. Opaque values a human still owns.
  (opaque
    (value BR2_ROOTFS_POST_IMAGE_SCRIPT "board/qemu/post-image.sh")
    ;; make expands this after Kconfig stores the literal
    (value BR2_ROOTFS_POST_SCRIPT_ARGS  "$(BR2_DEFCONFIG)"))

  ;; Two of the ten Kconfig trees Silt does not model (DESIGN.md §14.1).
  (unmanaged
    BR2_TARGET_UBOOT_*
    BR2_PACKAGE_BUSYBOX_CONFIG_*)

  (repair-policy
    (minimize changed-symbols)
    (baseline "buildroot/configs/qemu_aarch64_virt_defconfig"))

  ;; The release these claims were checked against. A fragment asserts things
  ;; that are true of a Buildroot release, not of Buildroot in general — every
  ;; failure `silt check --buildroot` exists to catch was release-specific.
  (verified-against (buildroot "2025.02.16")))
