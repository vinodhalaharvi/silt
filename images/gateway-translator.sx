;; Both protocols: the translator this whole argument was for.
;;
;; Measured: this image's defconfig is exactly the union of gateway-modbus and
;; gateway-mqtt, symbol for symbol. No interaction term, no pairwise special
;; case. Neither feature knows the other exists.
(image gateway-translator
  (compose
    target:qemu-aarch64-virt
    profile:minimal
    feature:networking
    feature:modbus
    feature:mqtt)
  (opaque
    (value buildroot:BR2_ROOTFS_POST_IMAGE_SCRIPT "board/qemu/post-image.sh")
    (value buildroot:BR2_ROOTFS_POST_SCRIPT_ARGS  "$(BR2_DEFCONFIG)"))
  (verified-against (buildroot "2025.02.16")))
