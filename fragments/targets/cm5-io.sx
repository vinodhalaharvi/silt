;; The official Compute Module 5 IO Board.
;;
;; Raspberry Pi's own carrier and reference design: one gigabit Ethernet,
;; two USB 3, dual HDMI, two MIPI connectors, an M.2 M-key slot, a real-time
;; clock with a battery holder, the 40-pin header, and a microSD slot for
;; Lite modules. It is what a CM5 development kit ships with, and what other
;; carriers are designed against.
;;
;; The device tree is the module-and-carrier pair: cm5 with eMMC on the cm5io
;; board. A Lite module on the same board is bcm2712-rpi-cm5l-cm5io, and a
;; CM5 in a CM4 IO board is bcm2712-rpi-cm5-cm4io - which is why the name
;; belongs here rather than in target:cm5.

(fragment target:cm5-io
  (doc "Raspberry Pi CM5 IO Board, with an eMMC module")

  ;; What this carrier has populated. No RS485, no CAN, one Ethernet: it is
  ;; a development board, not an industrial one.
  (provides
    ;; The module's, claimed here because a carrier is only ever a board
    ;; with a module in it, and only a target may claim a capability.
    (capability compiler)
    (capability glibc)
    (capability mmu)

    (capability csi-camera)
    (capability sdcard)
    (capability serial-console)
    (capability nvme))

  (buildroot
    ;; The BCM2712's 4k page size fragment, stated by the target for the same
    ;; reason every Raspberry Pi target states it: silt writes its own kernel
    ;; fragment into this symbol, and only a target's value survives that.
    (path-append BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES "board/raspberrypi/linux-4k-page-size.fragment")
    (value BR2_LINUX_KERNEL_INTREE_DTS_NAME "broadcom/bcm2712-rpi-cm5-cm5io")))
