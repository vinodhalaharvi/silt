;; Imported by silt import from configs/raspberrypi5_defconfig, buildroot 2025.02.16.
;; The target/profile split is a first cut by rule; the rule is noted on
;; every line. Move lines between the two fragments freely.

(fragment target:raspberrypi5
  (doc "target part of raspberrypi5_defconfig")

  ;; Derived from kbuild's .config of the source, not asserted.
  (provides
    (capability compiler)
    (capability glibc)
    (capability mmu))

  ;; A defconfig cannot answer these: no symbol says whether the board
  ;; has the hardware. The Pi 5 has two CSI connectors (CAM/DISP 0 and 1),
  ;; an SD slot and a serial console on the GPIO header.
  (provides
    (capability csi-camera)
    (capability sdcard)
    (capability serial-console))

  ;; Not claimed: virtio (not a VM) and wifi-sdio (the Pi 5's wifi is on
  ;; the RP1 side, and nothing here has needed to say so yet).

  (buildroot
    (y BR2_aarch64)                                            ; :1 defined under arch/
    (y BR2_cortex_a76)                                         ; :2 defined under arch/
    ;; Headers stay at 6.12 under a 6.18 kernel, which is correct rather
    ;; than a compromise. Buildroot's own help: "the kernel headers must be
    ;; at least as old as the oldest kernel you intend to run on your
    ;; target" - older headers than the kernel is the supported direction,
    ;; and newer headers than the kernel is the mistake. 6.12 is also the
    ;; newest series Buildroot 2025.02.16 offers.
    (y BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12)
    (n BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6)
    (value BR2_GLOBAL_PATCH_DIR "board/raspberrypi/patches")   ; :5 board integration hook
    (value BR2_ROOTFS_POST_BUILD_SCRIPT "board/raspberrypi5/post-build.sh") ; :8 board integration hook
    (value BR2_ROOTFS_POST_IMAGE_SCRIPT "board/raspberrypi5/post-image.sh") ; :9 board integration hook
    (y BR2_LINUX_KERNEL)                                       ; :10 defined under linux/ (kernel)
    (y BR2_LINUX_KERNEL_CUSTOM_TARBALL)                        ; :11 defined under linux/ (kernel)
    ;; The Raspberry Pi kernel, bumped from the 6.6.28 tarball Buildroot
    ;; 2025.02.16 pins (commit 576cc10e, April 2024) to the tip of
    ;; rpi-6.12.y.
    ;;
    ;; The pinned one does not boot a Pi 5 Model B Rev 1.1. Not this image
    ;; and not Buildroot's own raspberrypi5_defconfig, which is the test
    ;; that showed the fault is upstream rather than here: stock Buildroot,
    ;; no silt involved, firmware runs, kernel never starts. Raspberry Pi OS
    ;; on the same board runs 6.18 and is fine, and the board is healthy - it
    ;; boots, gets an address and answers ssh.
    ;;
    ;; 6.18 rather than 6.12, because the board is known to boot 6.18: that
    ;; is what Raspberry Pi OS runs on it (6.18.50+rpt-rpi-2712), and
    ;; matching the series that demonstrably works removes a variable rather
    ;; than introducing a third untested one. rpi-6.18.y reports 6.18.54.
    ;;
    ;; Checked before changing it: bcm2712_defconfig is still there, both
    ;; device trees are still there, CONFIG_ARM64_4K_PAGES still exists so
    ;; Buildroot's page-size fragment still applies, the defconfig wants no
    ;; Rust, no BTF, no module signing and no gcc plugins, and Buildroot
    ;; 2025.02.16 has no kernel version gate.
    ;;
    ;; rpi-6.18.y is a branch, so this is its tip rather than a tag: the
    ;; Foundation does not tag these and a commit is the only reproducible
    ;; thing on offer. If this fails to build, a553c4648f68caaa9fe246adb40269af771a0ee7
    ;; is the tip of rpi-6.12.y and the smaller jump.
    (value BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION "$(call github,raspberrypi,linux,1e807154dbf9733995f5337e74602d3f82544c6e)/linux-1e807154dbf9733995f5337e74602d3f82544c6e.tar.gz") ; :12 defined under linux/ (kernel)
    (value BR2_LINUX_KERNEL_DEFCONFIG "bcm2712")               ; :13 defined under linux/ (kernel)
    (path-append BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES "board/raspberrypi/linux-4k-page-size.fragment") ; :14 defined under linux/ (kernel)
    (y BR2_LINUX_KERNEL_DTS_SUPPORT)                           ; :15 defined under linux/ (kernel)
    (value BR2_LINUX_KERNEL_INTREE_DTS_NAME "broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b") ; :16 defined under linux/ (kernel)
    (y BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL)                    ; :17 defined under linux/ (kernel)
    (y BR2_PACKAGE_RPI_FIRMWARE)                               ; :20 firmware package
    (value BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE "board/raspberrypi5/config_5.txt") ; :21 firmware package
    (value BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE "board/raspberrypi5/cmdline_5.txt") ; :22 firmware package
    (n BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS)          ; :23 firmware package
    (y BR2_PACKAGE_HOST_DOSFSTOOLS)                            ; :30 host tool, typically for boot media
    (y BR2_PACKAGE_HOST_GENIMAGE)                              ; :31 host tool, typically for boot media
    (y BR2_PACKAGE_HOST_KMOD_XZ)                               ; :32 host tool, typically for boot media
    (y BR2_PACKAGE_HOST_MTOOLS)                                ; :33 host tool, typically for boot media
  ))
