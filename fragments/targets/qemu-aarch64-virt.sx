;; QEMU 'virt' machine, AArch64. Boots under qemu-system-aarch64.

(fragment target:qemu-aarch64-virt

  (buildroot
    ;; Choice: Kconfig offers every ARM64 core, picking one is intent.
    (y BR2_aarch64)
    (y BR2_cortex_a57)
    (value BR2_TARGET_GENERIC_GETTY_PORT "ttyAMA0")

    ;; Build a kernel at all. Stating CONFIG_* symbols does not imply this:
    ;; they describe a kernel's content, while this switches the kernel package
    ;; on. Omitting it produced a rootfs and no Image, and nothing warned —
    ;; qemu simply refused to load a kernel that was never built.
    (y BR2_LINUX_KERNEL)
    ;; Track the release's own kernel. This also makes the Kernel Headers
    ;; choice follow automatically, so no header series has to be stated.
    (y BR2_LINUX_KERNEL_LATEST_VERSION)
    ;; arm64 boots a flat "Image"; the symbol depends on BR2_aarch64, which is
    ;; why this belongs to the target rather than a profile.
    (y BR2_LINUX_KERNEL_IMAGE)
    ;; Base config is the kernel's own arm64 defconfig. Silt's linux.config is
    ;; layered on top as a fragment — see emit/defconfig.go.
    (y BR2_LINUX_KERNEL_USE_DEFCONFIG)
    (value BR2_LINUX_KERNEL_DEFCONFIG "defconfig"))

  (linux
    ;; Strengthening. Kconfig permits =m for both of these. The rootfs is on
    ;; virtio and the console is needed before userspace, so neither can be a
    ;; module. Kconfig cannot express boot ordering; this is why the fragment
    ;; exists at all.
    ;;
    ;; Pairs with `-drive if=virtio` on `-machine virt`, which is virtio-pci.
    (y CONFIG_VIRTIO_BLK)
    (y CONFIG_VIRTIO_PCI)
    (y CONFIG_SERIAL_AMBA_PL011_CONSOLE))

  (provides
    (capability mmu)
    (capability virtio)
    (capability serial-console)))

;; Derived, therefore absent: CONFIG_ARM64 (set by ARCH=arm64), CONFIG_VIRTIO
;; (selected by VIRTIO_BLK), CONFIG_SERIAL_AMBA_PL011 (depended on by the console
;; symbol). Rootfs format, kernel version and init system are left unconstrained
;; for a profile to fill by unification — that is the whole reuse mechanism.
