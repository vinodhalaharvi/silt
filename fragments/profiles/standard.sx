;; glibc, systemd, room to breathe. The repair target when profile:minimal is too
;; tight — see images/edge-camera.sx.

(fragment profile:standard

  (buildroot
    (y BR2_TOOLCHAIN_BUILDROOT_GLIBC)
    (y BR2_INIT_SYSTEMD)
    (y BR2_TARGET_ROOTFS_EXT2)
    (y BR2_TARGET_ROOTFS_EXT2_4)
    (value BR2_TARGET_ROOTFS_EXT2_SIZE "512M"))

  (linux
    (y CONFIG_EXT4_FS)
    (y CONFIG_DEVTMPFS_MOUNT)
    ;; systemd's kernel requirements are NOT stated here. They belong to
    ;; BR2_INIT_SYSTEMD wherever it is chosen, not to this profile, so they live
    ;; in rules/cross-tree.sx sourced from systemd's own README. Stating them
    ;; here would be a second copy to drift.
    )

  (requires
    (capability mmu)))
