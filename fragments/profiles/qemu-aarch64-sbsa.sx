;; Imported by silt import from configs/qemu_aarch64_sbsa_defconfig, buildroot 2025.02.16.
;; The target/profile split is a first cut by rule; the rule is noted on
;; every line. Move lines between the two fragments freely.

(fragment profile:qemu-aarch64-sbsa
  (doc "profile part of qemu_aarch64_sbsa_defconfig")

  (buildroot
    (y BR2_DOWNLOAD_FORCE_CHECK_HASHES)                        ; :5 not hardware by any rule above
    (value BR2_SYSTEM_DHCP "eth0")                             ; :7 not hardware by any rule above
    (y BR2_TARGET_ROOTFS_EXT2)                                 ; :16 not hardware by any rule above
    (y BR2_TARGET_ROOTFS_EXT2_4)                               ; :17 not hardware by any rule above
    (value BR2_TARGET_ROOTFS_EXT2_SIZE "128M")                 ; :18 not hardware by any rule above
    (n BR2_TARGET_ROOTFS_TAR)                                  ; :19 not hardware by any rule above
  ))
