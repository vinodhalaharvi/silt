;; The capability vocabulary.
;;
;; Before this file existed, `provides` and `requires` were matched by string
;; alone: the same typo on both sides composed cleanly and meant nothing, and
;; `mmu` had no connection to BR2_USE_MMU, which is a real symbol Buildroot
;; already maintains. Declaring each name once makes a typo an error and gives
;; every capability somewhere to say what it means.
;;
;; `symbol` is optional. Some capabilities correspond to a Kconfig symbol and
;; some — an outcome rather than a setting — do not. Saying so is the point.

(capabilities

  (capability mmu
    (doc "The target has a memory management unit.")
    (symbol buildroot:BR2_USE_MMU))

  (capability virtio
    (doc "The target exposes virtio devices for storage and network."))

  (capability serial-console
    (doc "The target has a serial console usable before userspace starts."))

  (capability sdcard
    (doc "The target boots from and mounts an SD card."))

  (capability wifi-sdio
    (doc "The target has an SDIO-attached wireless chipset."))

  ;; Userspace outcomes a profile decides, which packages may need to exist
  ;; at all: k3s ships systemd units and is built against glibc, and neither
  ;; is a property of a board.
  (capability systemd-init
    (doc "PID 1 is systemd, so a package may ship units and expect them run.")
    (symbol buildroot:BR2_INIT_SYSTEMD))

  (capability glibc
    (doc "The C library is glibc: binaries built against it will run.")
    (symbol buildroot:BR2_TOOLCHAIN_USES_GLIBC))

  (capability csi-camera
    (doc "The target has a CSI camera interface."))

  ;; An outcome, not a setting. No single symbol expresses it: profile:minimal
  ;; satisfies it with BusyBox udhcpc and profile:standard with
  ;; systemd-networkd. A feature that named either one broke on the other.
  (capability dhcp-client
    (doc "Something in the image configures the primary interface over DHCP."))

  ;; Forbidding needs every implementation named, not one. A capability with
  ;; one symbol bound and three implementations in the tree gives an absence
  ;; claim that reads as verified and is not.
  (capability remote-shell
    (doc "Something in the image accepts an interactive login over the network.")
    (symbol buildroot:BR2_PACKAGE_DROPBEAR)
    (symbol buildroot:BR2_PACKAGE_OPENSSH))

  ;; What a carrier board has populated. A Compute Module has no connectors,
  ;; so every one of these is a property of the board it is plugged into, and
  ;; a feature that needs one cannot compose onto a carrier that lacks it.
  ;; None binds to a symbol: a board either has the transceiver fitted or it
  ;; does not, and no Kconfig option knows.
  (capability rs485
    (doc "The board has an RS485 transceiver on a serial port."))

  (capability can-bus
    (doc "The board has a CAN transceiver on a CAN controller."))

  (capability dual-ethernet
    (doc "The board has two Ethernet ports, so it can sit between networks."))

  (capability nvme
    (doc "The board has an M.2 slot wired to PCIe for an NVMe drive."))

  (capability cellular
    (doc "The board has an M.2 or Mini-PCIe slot for a 4G/5G or LoRa module."))

  (capability compiler
    (doc "The image carries a compiler or assembler usable on the target.")
    (symbol buildroot:BR2_PACKAGE_GCC_FINAL)
    (symbol buildroot:BR2_PACKAGE_BINUTILS)))
